{
  "_comment": "Sanitized config — no credentials. Secrets are injected via K8s Secrets / env vars.",

  "secret_key": "",

  "auth": {
    "_comment": "Auth credentials are injected via ADMIN_USERNAME/ADMIN_PASSWORD and USER_USERNAME/USER_PASSWORD env vars.",
    "session_lifetime_minutes": 480,
    "secure_cookie": true,
    "local_admins": [],
    "local_users": []
  },

  "base_url": "",
  "cribl_urls": [],
  "elk_urls": [],
  "skip_ssl": false,

  "credentials": {
