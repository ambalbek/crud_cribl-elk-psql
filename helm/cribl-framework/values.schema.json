{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "external", "framework", "criblService", "eceService", "etnOnboarding"],
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["", "Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": { "type": "object" },
        "requests": { "type": "object" }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k)?$" },
        "storageClass": { "type": "string" }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "schedulingFields": {
      "type": "object",
      "properties": {
        "extraEnv": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array" }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": { "type": "array" },
        "logLevel": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
        "logFormat": { "type": "string", "enum": ["text", "json"] },
        "otlpEndpoint": { "type": "string" },
        "priorityClassName": { "type": "string" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "portalFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "tests": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "external": {
      "type": "object",
      "required": ["cribl", "elasticsearch", "ece", "postgres"],
      "properties": {
        "cribl": {
          "type": "object",
          "properties": {
            "baseUrl": { "type": "string" },
            "token": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "skipSsl": { "type": "string", "enum": ["true", "false"] },
            "timeout": { "type": "string", "pattern": "^[0-9]+$" },
            "defaultWorkspace": { "type": "string" },
            "defaultRoutesTable": { "type": "string" },
            "minExistingRoutes": { "type": "string", "pattern": "^[0-9]+$" }
          }
        },
        "elasticsearch": {
          "type": "object",
          "properties": {
            "datastreamUrl": { "type": "string" },
            "datastreamUsername": { "type": "string" },
            "datastreamPassword": { "type": "string" },
            "elkEsUrl": { "type": "string" },
            "elkKibanaUrl": { "type": "string" },
            "elkLogstashUrl": { "type": "string" }
          }
        },
        "ece": {
          "type": "object",
          "properties": {
            "esUrl": { "type": "string" },
            "esToken": { "type": "string" },
            "esUsername": { "type": "string" },
            "esPassword": { "type": "string" },
            "esUrlProd": { "type": "string" },
            "esTokenProd": { "type": "string" },
            "esUsernameProd": { "type": "string" },
            "esPasswordProd": { "type": "string" },
            "kibanaUrl": { "type": "string" },
            "kibanaToken": { "type": "string" },
            "kibanaUsername": { "type": "string" },
            "kibanaPassword": { "type": "string" },
            "skipSsl": { "type": "string", "enum": ["true", "false"] }
          }
        },
        "postgres": {
          "type": "object",
          "properties": {
            "frameworkDatabaseUrl": { "type": "string", "pattern": "^$|^postgresql(\\+[a-z0-9]+)?://" },
            "etnDatabaseUrl": { "type": "string", "pattern": "^$|^postgresql(\\+[a-z0-9]+)?://" }
          }
        }
      }
    },
    "framework": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "$ref": "#/definitions/replicaCount" },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "secretKey": { "type": "string" },
        "etnOnboardingToken": { "type": "string" },
        "existingSecret": { "type": "string" },
        "config": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "content": { "type": "string" }
          }
        },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "type": "object" },
        "extraVolumes": { "type": "array" },
        "extraVolumeMounts": { "type": "array" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array" },
        "route": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "tlsTermination": { "type": "string", "enum": ["edge", "passthrough", "reencrypt"] }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "host": { "type": "string" },
            "annotations": { "type": "object" },
            "tls": { "type": "array" }
          }
        }
      }
    },
    "criblService": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "$ref": "#/definitions/replicaCount" },
        "image": { "$ref": "#/definitions/image" },
        "existingSecret": { "type": "string" },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array" }
      }
    },
    "eceService": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "$ref": "#/definitions/replicaCount" },
        "image": { "$ref": "#/definitions/image" },
        "existingSecret": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array" }
      }
    },
    "etnOnboarding": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "$ref": "#/definitions/replicaCount" },
        "image": { "$ref": "#/definitions/image" },
        "secretKey": { "type": "string" },
        "authLocalUsers": { "type": "string" },
        "etnPortalUrl": { "type": "string" },
        "etnPortalApiKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "migrationJob": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "backoffLimit": { "type": "integer", "minimum": 0 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array" }
      }
    }
  }
}
