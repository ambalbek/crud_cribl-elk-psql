{
  "_comment": "Base config baked into the image. Contains NO credentials. Secrets are merged at startup from Conjur (AZURE_CLIENT_SECRET) or a mounted K8s secret.",

  "log_level": "INFO",
  "log_format": "text",

  "cribl_service_url": "http://cribl-service:8001",
  "ece_service_url": "http://ece-service:8002",
  "etn_onboarding_url": "http://etn-onboarding:5000",

  "secret_key": "",

  "auth": {
    "session_lifetime_minutes": 480,
    "local_admins": [],
    "local_users": []
  },

  "base_url": "",
  "skip_ssl": false,

  "credentials": {
    "token": "",
    "username": "",
    "password": ""
  },

  "route_templates": {
    "azn": "route_template_azn.json",
    "azs": "route_template_azs.json"
  },
  "dest_prefixes": {
    "azn": "hcsc-blob-storage-northcentralus",
    "azs": "hcsc-blob-storage-southcentralus"
  },
  "snapshot_dir": "cribl_snapshots",
  "min_existing_total_routes": 1,
  "diff_lines": 3,

  "workspaces": {
    "trec_dev": {
      "worker_groups": ["default"],
      "dest_templates": {
        "azn": "blob_dest_template_azn_dev.json",
        "azs": "blob_dest_template_azs_dev.json"
      },
      "description": "Development workspace"
    },
    "dev": {
      "worker_groups": [
        "default", "wg-dev-01", "wg-dev-02", "wg-dev-03", "wg-dev-04",
        "wg-dev-05", "wg-dev-06", "wg-dev-07", "wg-dev-08",
        "wg-dev-09", "wg-dev-10", "wg-dev-11", "wg-dev-12"
      ],
      "dest_templates": {
        "azn": "blob_dest_template_azn_dev.json",
        "azs": "blob_dest_template_azs_dev.json"
      },
      "description": "Development workspace"
    },
    "test": {
      "worker_groups": [
        "wg-test-01", "wg-test-02", "wg-test-03", "wg-test-04",
        "wg-test-05", "wg-test-06", "wg-test-07", "wg-test-08",
        "wg-test-09", "wg-test-10", "wg-test-11", "wg-test-12"
      ],
      "dest_templates": {
        "azn": "blob_dest_template_azn_test.json",
        "azs": "blob_dest_template_azs_test.json"
      },
      "description": "Test workspace"
    },
    "prod": {
      "worker_groups": [
        "wg-prod-01", "wg-prod-02", "wg-prod-03", "wg-prod-04",
        "wg-prod-05", "wg-prod-06", "wg-prod-07", "wg-prod-08",
        "wg-prod-09", "wg-prod-10", "wg-prod-11", "wg-prod-12"
      ],
      "dest_templates": {
        "azn": "blob_dest_template_azn_prod.json",
        "azs": "blob_dest_template_azs_prod.json"
      },
      "description": "Production workspace",
      "require_allow": true
    }
  },

  "ldap": {
    "server": "",
    "bind_dn": "",
    "bind_pw": "",
    "base_dn": "",
    "use_ssl": true
  },

  "iiq_url": "",
  "dynatrace_url": "",

  "database": {
    "url": ""
  },

  "datastream": {
    "elk_url": "",
    "token": "",
    "username": "",
    "password": "",
    "index": "cribl-onboarding-requests",
    "skip_ssl": true,
    "timeout": 30
  },

  "entitlement": {
    "clusters": [],
    "entitlementFilter": "entitlements"
  },

  "ece": {
    "es_url": "",
    "es_token": "",
    "es_username": "",
    "es_password": "",
    "es_url_prod": "",
    "es_token_prod": "",
    "es_username_prod": "",
    "es_password_prod": "",
    "kibana_url": "",
    "kibana_token": "",
    "kibana_username": "",
    "kibana_password": "",
    "skip_ssl": true,
    "timeout": 60,
    "templates_dir": "ops_rm_r_templates_output"
  },

  "etn_onboarding": {
    "database_url": "",
    "secret_key": "",
    "auth_backend": "local",
    "auth_local_users": [],
    "cribl_service_url": "http://cribl-service:8001",
    "ece_service_url": "http://ece-service:8002",
    "etn_onboarding_url": "http://etn-onboarding:5000",
    "token": "",
    "etn_portal_url": "",
    "etn_portal_api_key": ""
  }
}
