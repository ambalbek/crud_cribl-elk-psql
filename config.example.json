{
  "_comment": "Cribl Framework config. Use 'globals' for shared values — sections inherit and can override.",

  "globals": {
    "log_level": "INFO",
    "log_format": "text",
    "skip_ssl": false,
    "secret_key": "CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_STRING",
    "database_url": "postgresql://user:pass@postgres-host:5432/etn_onboarding",
    "elasticsearch_url": "https://elasticsearch-host:9200",
    "elasticsearch_token": "",
    "elasticsearch_username": "elastic",
    "elasticsearch_password": "CHANGE_ME",
    "cribl_url": "https://cribl-stream-host:9000",
    "cribl_token": "",
    "cribl_username": "admin",
    "cribl_password": "CHANGE_ME",
    "cribl_service_url": "http://cribl-service:8001",
    "ece_service_url": "http://ece-service:8002",
    "etn_onboarding_url": "http://etn-onboarding:5000",
    "inter_service_token": "CHANGE_ME"
  },

  "auth": {
    "session_lifetime_minutes": 480,
    "roles": {
      "admin":      { "description": "Full access to all pages and APIs", "pages": ["*"] },
      "developer":  { "description": "Onboarding portal, catalog, entitlements", "pages": ["portal", "catalog", "entitlements"] },
      "compliance": { "description": "Compliance tracker and catalog", "pages": ["compliance", "catalog"] },
      "user":       { "description": "Portal and entitlements only", "pages": ["portal", "entitlements"] }
    },
    "ad_group_mapping": {
      "_comment": "Maps AD/LDAP group DNs to local roles. Used when LDAP auth is enabled.",
      "CN=CriblAdmins,OU=Groups,DC=corp,DC=example,DC=com": "admin",
      "CN=CriblDevelopers,OU=Groups,DC=corp,DC=example,DC=com": "developer",
      "CN=CriblCompliance,OU=Groups,DC=corp,DC=example,DC=com": "compliance"
    },
    "local_admins": [
      {
        "username": "admin",
        "password": "CHANGE_ME",
        "display_name": "Local Admin"
      }
    ],
    "local_users": [
      { "username": "dev1", "password": "dev1", "display_name": "Developer", "role": "developer" },
      { "username": "auditor", "password": "auditor", "display_name": "Auditor", "role": "compliance" }
    ]
  },

  "route_templates": {
    "azn": "route_template_azn.json",
    "azs": "route_template_azs.json"
  },
  "dest_prefixes": {
    "azn": "hcsc-blob-storage-northcentralus",
    "azs": "hcsc-blob-storage-southcentralus"
  },
  "snapshot_dir": "cribl_snapshots",
  "min_existing_total_routes": 1,
  "diff_lines": 3,

  "workspaces": {
    "_comment": "Each workspace can override base_url to target a different Cribl leader (e.g. azn vs azs).",
    "dev_azn": {
      "base_url": "https://cribl.azn.com:9000",
      "worker_groups": ["default"],
      "dest_templates": {"azn": "blob_dest_template_azn_dev.json"},
      "description": "Dev - Azure North"
    },
    "dev_azs": {
      "base_url": "https://cribl.azs.com:9000",
      "worker_groups": ["default"],
      "dest_templates": {"azs": "blob_dest_template_azs_dev.json"},
      "description": "Dev - Azure South"
    },
    "prod_azn": {
      "base_url": "https://cribl.azn.com:9000",
      "worker_groups": ["wg-prod-01"],
      "dest_templates": {"azn": "blob_dest_template_azn_prod.json"},
      "description": "Prod - Azure North",
      "require_allow": true
    },
    "prod_azs": {
      "base_url": "https://cribl.azs.com:9000",
      "worker_groups": ["wg-prod-01"],
      "dest_templates": {"azs": "blob_dest_template_azs_prod.json"},
      "description": "Prod - Azure South",
      "require_allow": true
    }
  },

  "ldap": {
    "server": "ldaps://ldap.corp.example.com:636",
    "bind_dn": "CN=svc-cribl,OU=ServiceAccounts,DC=corp,DC=example,DC=com",
    "bind_pw": "CHANGE_ME",
    "base_dn": "DC=corp,DC=example,DC=com",
    "use_ssl": true
  },

  "iiq_url": "https://iiq.company.com/MOYAACESS",
  "dynatrace_url": "https://dynatrace.company.com/questionnaire",

  "datastream": {
    "_comment": "Only overrides needed — url/creds come from globals",
    "index": "cribl-onboarding-requests",
    "timeout": 30
  },

  "entitlement": {
    "_comment": "Cluster url/creds come from globals. Add multiple clusters to override.",
    "clusters": [
      { "name": "nonprod" },
      {
        "name": "prod",
        "url": "https://prod-es-host:9200",
        "token": "PROD_API_KEY",
        "skip_ssl": false
      }
    ],
    "entitlementFilter": "entitlements"
  },

  "ece": {
    "_comment": "Nonprod url/creds come from globals. Only prod overrides needed.",
    "es_url_prod": "https://prod-es-host:9200",
    "es_token_prod": "PROD_API_KEY",
    "timeout": 60,
    "templates_dir": "ops_rm_r_templates_output"
  },

  "etn_onboarding": {
    "_comment": "Most values come from globals. Only auth config is section-specific.",
    "auth_backend": "local",
    "auth_local_users": [
      {"username": "portal", "token": "CHANGE_ME", "roles": ["platform_admin"]}
    ]
  }
}
